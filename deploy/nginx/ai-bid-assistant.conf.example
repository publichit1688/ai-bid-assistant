server {
    listen 443 ssl http2;
    server_name bid.example.com;

    # Replace with deployment-managed certificate paths.
    ssl_certificate /etc/ssl/certs/bid.example.com.crt;
    ssl_certificate_key /etc/ssl/private/bid.example.com.key;

    client_max_body_size 50m;

    # The application emits normalized request logs. Disable the default
    # proxy access log because it would retain customer upload filenames.
    access_log off;
    error_log /var/log/nginx/ai-bid-assistant.error.log warn;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}

server {
    listen 80;
    server_name bid.example.com;
    return 301 https://$host$request_uri;
}
