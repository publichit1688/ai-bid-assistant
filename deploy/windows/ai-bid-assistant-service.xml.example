<service>
  <id>ai-bid-assistant</id>
  <name>AI Bid Assistant API</name>
  <description>AI Bid Assistant FastAPI production process</description>
  <executable>C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</executable>
  <arguments>-NoProfile -ExecutionPolicy Bypass -File C:\AI-Bid-Assistant\deploy\windows\start-backend.ps1</arguments>
  <workingdirectory>C:\AI-Bid-Assistant\backend</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="5 sec" />
  <stoptimeout>30 sec</stoptimeout>
  <logpath>C:\AI-Bid-Assistant\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
