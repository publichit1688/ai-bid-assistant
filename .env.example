# 复制为 .env 后填写真实值；.env 不得提交到 Git。
DATABASE_URL=sqlite:///./bid.db
UPLOAD_DIR=uploads
REPORT_DIR=reports
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_MAX_BYTES=52428800
APP_HOST=127.0.0.1
APP_PORT=8000
APP_WORKERS=1
APP_LOG_LEVEL=info
# 本地默认关闭；部署时设为 shared_token，并配置至少 32 位随机密钥。
AUTH_MODE=disabled
APP_ACCESS_TOKEN=
RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=30
AI_RATE_LIMIT=60
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=127.0.0.1,::1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 留空时：标书分析沿用 deepseek-v4-flash，对比和 Dashboard 沿用 deepseek-chat。
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_SECONDS=60

# DOC/DOCX 版式预览：Microsoft Word 主用，WPS Office 备用。
WORD_PREVIEW_RENDERERS=microsoft_word,wps
MICROSOFT_WORD_PATH=
WPS_OFFICE_PATH=

# 扫描 PDF OCR。保持 disabled 可避免文件意外发送到第三方。
OCR_PROVIDER=disabled
OCR_MIN_TEXT_CHARS=20
OCR_MAX_PAGES=50
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/general
BAIDU_OCR_TIMEOUT_SECONDS=30
